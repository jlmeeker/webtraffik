[Unit]
Description=webTraffik — real-time HTTP traffic world map
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=webtraffik
Group=webtraffik

# Binary and working directory (GeoLite2 DB stored here).
# Config is auto-loaded from /etc/webtraffik/config.yaml if present.
# CLI flags always override config file values. Examples:
#   ExecStart=/usr/local/bin/webtraffik -disable-ports=22,80,443
#   ExecStart=/usr/local/bin/webtraffik -config=/etc/webtraffik/config.yaml
# Generate /sys/kernel/btf/vmlinux from DWARF debug info if missing.
# Required for eBPF CO-RE on kernels without built-in BTF (e.g. Raspberry Pi OS).
# Runs as root (+), exits 0 always — failure is non-fatal (app falls back to go-only).
ExecStartPre=+/usr/local/lib/webtraffik/gen-btf.sh
ExecStart=/usr/local/bin/webtraffik
WorkingDirectory=/var/lib/webtraffik

# Allow the service to read the config directory.
ReadOnlyPaths=/etc/webtraffik

# Allow binding to ports <1024 without root.
# CAP_BPF and CAP_NET_ADMIN are required for eBPF hybrid/ebpf-only modes.
# The app automatically falls back to go-only if eBPF is unavailable.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_BPF CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_BPF CAP_NET_ADMIN

# Restart on failure
Restart=on-failure
RestartSec=5s

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/webtraffik

# Logging goes to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=webtraffik

[Install]
WantedBy=multi-user.target
