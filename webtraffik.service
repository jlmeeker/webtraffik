[Unit]
Description=webTraffik — real-time HTTP traffic world map
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=webtraffik
Group=webtraffik

# Binary and working directory (GeoLite2 DB stored here)
# To disable specific ports (e.g. if they conflict with real services), add
# -disable-ports to ExecStart. Update firewall.sh with DISABLE_PORTS= to match.
# Example: ExecStart=/usr/local/bin/webtraffik -disable-ports=22,80,443
ExecStart=/usr/local/bin/webtraffik
WorkingDirectory=/var/lib/webtraffik

# Allow binding to ports <1024 without root.
# For eBPF hybrid/ebpf-only modes, also add CAP_BPF and CAP_NET_ADMIN:
#   AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_BPF CAP_NET_ADMIN
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_BPF CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Restart on failure
Restart=on-failure
RestartSec=5s

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/webtraffik

# Logging goes to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=webtraffik

[Install]
WantedBy=multi-user.target
