[Unit]
Description=webTraffik — network traffic sensor and honeypot
Documentation=https://github.com/jlmeeker/webtraffik
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=webtraffik
Group=webtraffik
WorkingDirectory=/var/lib/webtraffik

# Config is auto-loaded from /etc/webtraffik/config.yaml. CLI flags override it:
#   ExecStart=/usr/local/bin/webtraffik -disable-ports=22,80
# Generate /sys/kernel/btf/vmlinux if the kernel lacks it (non-fatal; the app
# falls back to go-only if eBPF cannot load). Runs as root (+).
ExecStartPre=+/usr/local/lib/webtraffik/gen-btf.sh
ExecStart=/usr/local/bin/webtraffik
# SIGHUP reloads the eBPF management allow-list without a restart.
ExecReload=/bin/kill -HUP $MAINPID
# SIGTERM triggers a graceful shutdown (drain, flush, detach XDP).
TimeoutStopSec=30

# Bind ports <1024 without root. CAP_BPF + CAP_NET_ADMIN attach the XDP
# program; CAP_PERFMON reads its perf event stream (kernel >= 5.8). The app
# falls back to go-only automatically if eBPF is unavailable.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_BPF CAP_NET_ADMIN CAP_PERFMON
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_BPF CAP_NET_ADMIN CAP_PERFMON
LimitMEMLOCK=infinity

Restart=on-failure
RestartSec=5s

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/webtraffik
ReadOnlyPaths=/etc/webtraffik

StandardOutput=journal
StandardError=journal
SyslogIdentifier=webtraffik

[Install]
WantedBy=multi-user.target
