# webTraffik configuration file
#
# Default location: /etc/webtraffik/config.yaml (auto-detected on startup).
# Use another path with: webtraffik -config=/path/to/config.yaml
#
# Every key is optional and matches a CLI flag of the same name.
# Precedence: CLI flag > this file > built-in default.
# Unknown keys are an ERROR (so a typo cannot silently do nothing).
#
# Reload without a restart (SIGHUP):   systemctl reload webtraffik
#   -> re-reads mgmt-allow-file only. Everything else needs a restart.

# ── Capture ───────────────────────────────────────────────────────────────────
#
# hybrid   (default) eBPF/XDP drops banned IPs in the kernel; Go listeners
#          emulate the services and capture payloads.
# ebpf-only XDP only — no Go listeners (no banners, credentials or payloads).
# go-only  pure userspace; works anywhere, no extra capabilities.
#
# If XDP cannot attach (no CAP_BPF/CAP_NET_ADMIN/CAP_PERFMON, kernel < 5.10,
# unsupported driver) hybrid/ebpf-only fall back to go-only automatically.
#
# capture-mode: hybrid
# ebpf-iface: eth0                  # default: interface of the default route
# mgmt-ports: "8999,22"             # never dropped/logged by XDP (default: dashboard port + 22)
# mgmt-allow-file: /etc/webtraffik/allow.txt   # one IP (v4 or v6) per line; SIGHUP reloads
# disable-ports: ""                 # ports to NOT bind, e.g. "22,80" if real services use them
#                                   # (pass the same list to firewall.sh via DISABLE_PORTS)
# max-conns: 4096                   # concurrent emulated connections across all listeners

# ── Dashboard ─────────────────────────────────────────────────────────────────
#
# By default the dashboard listens on :8999 and relies on the firewall (subnet
# only). Strongly recommended: enable authentication. install.sh does this for
# fresh installs.
#
# dashboard-listen: ":8999"         # e.g. "127.0.0.1:8999" behind a reverse proxy
# dashboard-user: admin
# dashboard-pass-file: /etc/webtraffik/dashboard.pass   # or $WEBTRAFFIK_DASHBOARD_PASS
# allowed-origins: ""               # extra Origin hosts (your reverse proxy's name)

# ── Data ──────────────────────────────────────────────────────────────────────
#
# data-dir: /var/lib/webtraffik     # default: working directory
# retention-days: 90                # delete events older than this; 0 = keep forever
# export-jsonl: /var/lib/webtraffik/events.jsonl   # append every event as a JSON line
# export-max-mb: 100                # rotate to <file>.1 at this size
# public-ip: ""                     # override auto-discovery; "none" skips it

# ── Geolocation ───────────────────────────────────────────────────────────────
#
# disable-rgeo: false               # skip the city-name fallback (faster start on a Pi)
# disable-asn: false                # skip ASN / organisation enrichment
# geo-refresh: "168h"               # refresh the databases this often; "0" disables
# geo-city-url: https://github.com/P3TERX/GeoLite.mmdb/raw/download/GeoLite2-City.mmdb
# geo-asn-url:  https://github.com/P3TERX/GeoLite.mmdb/raw/download/GeoLite2-ASN.mmdb
# geo-city-sha256: ""               # pin the City database download

# ── Logging ───────────────────────────────────────────────────────────────────
#
# log-level: info                   # debug logs every captured connection
# log-format: text                  # or json
